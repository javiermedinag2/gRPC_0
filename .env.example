# MongoDB: deja usuario y contrasena vacios si la instancia local no usa autenticacion.
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=Escuela
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin

# Direccion donde escucha gRPC y a la que se conecta el proxy.
GRPC_BIND_ADDRESS=localhost:50051
GRPC_SERVER_ADDRESS=127.0.0.1:50051

# Servidor HTTP/GraphQL.
GRAPHQL_HOST=0.0.0.0
GRAPHQL_PORT=8000
